# ============================================================
# AI 网文写作系统 v2.0 — 环境变量配置示例
# 使用方法：复制本文件为 .env，填写对应的 API Key 后启动程序
#   cp .env.example .env
# ============================================================

# ----------------------------------------------------------------
# 阿里云 DashScope（必填，支持 Qwen / 通义千问系列模型）
# 获取地址：https://dashscope.console.aliyun.com/apiKey
# ----------------------------------------------------------------
DASHSCOPE_API_KEY=sk-10a2a61572654e0d8d31c1e1c72ce00f

# DashScope 接入节点（可选，留空则由 config.yaml 的 api_region 决定）
# 中国大陆用户一般无需填写，程序会自动选择
# 如需强制指定：
#   中国大陆 → https://dashscope.aliyuncs.com/compatible-mode/v1
#   新加坡   → https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   美国     → https://dashscope-us.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_BASE_URL=

# ----------------------------------------------------------------
# Google Gemini（可选，使用 Gemini 系列模型时填写）
# 获取地址：https://aistudio.google.com/app/apikey
# ----------------------------------------------------------------
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx